{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writing Room",
  "version": "0.1.0",
  "identifier": "jp.rashita.writingroom",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Writing Room",
        "width": 1120,
        "height": 780,
        "minWidth": 700,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-src project: http://project.localhost; img-src 'self' data: project: http://project.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "執筆プロジェクトの作業室",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
